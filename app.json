{
  "expo": {
    "name": "a.iwish",
    "slug": "aiwish",
    "owner": "maymichaeli",
    "version": "1.0.0",
    "scheme": "aiwish",
    "orientation": "portrait",
    "icon": "./assets/aiwish-nobg.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "biz.chefi.aiwish"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "91e4cd7a-6214-4f30-9e03-aeed18f979a8"
      }
    }
  }
}
